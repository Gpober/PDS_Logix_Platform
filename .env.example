# PDS Logix CRM — environment
# Copy to .env.local and fill in. .env*.local is gitignored (see .gitignore).

# Public Supabase keys — safe to expose to the browser (anon/publishable key only).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# NOTE: the service-role key is NOT used by the public website and must never
# be placed here or shipped to the client. The public site reads only the
# public_* views and inserts leads, all under the anon role + RLS.

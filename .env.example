# Public Supabase keys — safe to expose to the browser (anon key only).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# NOTE: the service-role key is NOT used by the public website and must never
# be shipped to the client. It IS used by two narrow server-only tasks: emailing
# a new lead (looks up the owner's Google token) and the scheduled-publish cron
# (publishes due posts for any creator, with no user session). Set it in the
# server environment only — never NEXT_PUBLIC_, never in client code.
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---------------------------------------------------------------------------
# Instagram publishing (server-only). The creator "Connect Instagram" + publish
# flow uses Instagram Business Login. Create an Instagram app in the Meta
# developer dashboard and paste its ID/secret here.
# ---------------------------------------------------------------------------
# INSTAGRAM_APP_ID=YOUR-INSTAGRAM-APP-ID
# INSTAGRAM_APP_SECRET=YOUR-INSTAGRAM-APP-SECRET
# Canonical public URL, used to build the OAuth redirect (…/api/instagram/callback).
# NEXT_PUBLIC_SITE_URL=https://tulipstalent.co

# ---------------------------------------------------------------------------
# Scheduled auto-publish. A Vercel Cron (see vercel.json) calls /api/cron/publish
# every 5 min to post any scheduled content whose time has arrived. Vercel sends
# this secret as a Bearer token; the route rejects anything else. Requires
# SUPABASE_SERVICE_ROLE_KEY (above). NOTE: sub-daily crons need a Vercel Pro plan.
# ---------------------------------------------------------------------------
# CRON_SECRET=YOUR-LONG-RANDOM-STRING

# ---------------------------------------------------------------------------
# AI caption assist (server-only). Powers the "Draft with AI" button in the
# content planner — Claude writes a caption from the post's photo + linked brand.
# Get a key at console.anthropic.com. The button hides when this isn't set.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY

# ---------------------------------------------------------------------------
# TikTok publishing (server-only). Creators connect their TikTok account and
# direct-post videos/photos via the Content Posting API. Create an app at
# developers.tiktok.com (type "Other"), add Login Kit + Content Posting API,
# and register the redirect URL https://tulipstalent.co/api/tiktok/callback.
# Also verify the site domain (URL properties) so PULL_FROM_URL posting works.
# Until the app passes TikTok's audit, posts publish privately (SELF_ONLY).
# ---------------------------------------------------------------------------
# TIKTOK_CLIENT_KEY=awybjo5pe0h6emhd
# TIKTOK_CLIENT_SECRET=YOUR-TIKTOK-CLIENT-SECRET
# While the app is under review, test against the Sandbox (its own key/secret).
# Set TIKTOK_SANDBOX=true to use the _SB credentials; flip to false / unset to go
# live on the production key above. API endpoints are identical either way.
# TIKTOK_SANDBOX=true
# TIKTOK_CLIENT_KEY_SB=YOUR-TIKTOK-SANDBOX-CLIENT-KEY
# TIKTOK_CLIENT_SECRET_SB=YOUR-TIKTOK-SANDBOX-CLIENT-SECRET
# video.publish (Direct Post) is only granted after TikTok's app audit — it isn't
# available in the sandbox. Until then we request login-only so creators can still
# connect. Set TIKTOK_ENABLE_PUBLISH=true once the audit approves video.publish.
# TIKTOK_ENABLE_PUBLISH=true

# ---------------------------------------------------------------------------
# Google OAuth (server-only — never NEXT_PUBLIC_, never shipped to the browser).
# Same Client ID/secret you paste into the Supabase Google provider. Used here to
# refresh the user's Google access token server-side so the CRM can auto-sync
# bookings to Google Calendar and send/read Gmail on their behalf. Sign-in itself
# works without these; they're only needed for the Calendar/Gmail features.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR-GOOGLE-OAUTH-CLIENT-ID
GOOGLE_CLIENT_SECRET=YOUR-GOOGLE-OAUTH-CLIENT-SECRET

# ---------------------------------------------------------------------------
# Asana (server-only). Personal Access Token used by the CRM "Sync Asana" button
# to mirror Asana projects + tasks into Supabase (/crm/tasks). Create one at
# Asana → Settings → Apps → Developer apps → Personal access tokens. Optionally
# pin a workspace with ASANA_WORKSPACE (defaults to the token's first workspace).
# ---------------------------------------------------------------------------
ASANA_TOKEN=YOUR-ASANA-PERSONAL-ACCESS-TOKEN
# ASANA_WORKSPACE=1208781017343152
# Which Asana project feeds CRM leads (its tasks become leads, with email + pitch
# notes parsed from each task description). Defaults to the project whose name
# matches "Pitch Engine"/"Warm Lead"; set a gid to pin it explicitly.
# ASANA_LEADS_PROJECT_GID=1214470261772612

# ---------------------------------------------------------------------------
# I AM CFO partner read (server-only — never NEXT_PUBLIC_, never shipped to the
# browser). Powers the financials shown on /crm/financials. Tulips Talent is a
# client org inside I AM CFO; I AM CFO does the books and we read the result.
# ---------------------------------------------------------------------------
IAMCFO_API_URL=https://app.iamcfo.com
IAMCFO_API_TOKEN=YOUR-PARTNER-API-TOKEN
# I AM CFO is org-routed by subdomain, so set Tulips' subdomain here. The partner
# endpoint resolves it to the exact organization id in Supabase server-side — set
# this (or IAMCFO_ORG_ID if you have the UUID), not both.
IAMCFO_ORG_SUBDOMAIN=tulipstalent
# IAMCFO_ORG_ID=00000000-0000-0000-0000-000000000000
# "Open full books in I AM CFO" deep link. Defaults to https://<subdomain>.iamcfo.com
# (org-routed); set this only to override the host.
# IAMCFO_PORTAL_URL=https://tulipstalent.iamcfo.com

# Supabase — public keys (safe to expose to the browser; anon key only).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only — never NEXT_PUBLIC_, never shipped to the client.
# Optional for the web app (narrow server tasks that bypass RLS). REQUIRED for
# the Zordon team worker (worker/), which runs with no user session — see below.
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Server-only. Enables the "Zordon" AI assistant (owner/admin only). The
# Assistant tab shows a setup notice until this is set.
# Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY

# ---------------------------------------------------------------------------
# QuickBooks — via the I AM CFO platform (server-only). PDS's books live in
# I AM CFO under the "PDS Logix" org (Pride Dealer Services, QBO realm
# 123146415591129), exactly how Tulips runs. "Send to QuickBooks" on jobs and
# all of Zordon's invoice/bill tools go through the I AM CFO partner API — there
# is no direct Intuit login in this app. On the I AM CFO side, PARTNER_API_TOKEN
# must be set and QuickBooks must be connected for the pdslogix org.
# ---------------------------------------------------------------------------
# IAMCFO_API_URL=https://app.iamcfo.com
# IAMCFO_API_TOKEN=THE-PARTNER-API-TOKEN   # shared secret (PARTNER_API_TOKEN on I AM CFO)
# Which org's books. Defaults to 'pdslogix' (Pride Dealer Services) — only set
# these to target a different org.
# IAMCFO_ORG_SUBDOMAIN=pdslogix
# IAMCFO_ORG_ID=                            # optional; wins over the subdomain

# ---------------------------------------------------------------------------
# Zordon's books — READ access to PDS's financial ledger (server-only).
# Zordon's financials / client_financials / ar_aging / cash_calendar tools read
# the "PDS Logix" I AM CFO data warehouse directly — the SAME synced QuickBooks
# ledger the pdslogix.net dashboards use — so Zordon shows the same numbers plus
# per-client breakdowns. Reads only; invoicing still goes through the I AM CFO
# partner API above. Without these, the books tools return a "not connected"
# notice and everything else keeps working.
# ---------------------------------------------------------------------------
# PDS_BOOKS_SUPABASE_URL=https://bdtmsfbhaztukqppnhdk.supabase.co
# PDS_BOOKS_SUPABASE_KEY=THE-DATA-WAREHOUSE-KEY   # a key that can read the finance tables
# PDS_BOOKS_ORG_ID=                               # optional; scope to one org (warehouse holds one company)
# Cash-flow statement anchor: the cash-flow sections + net change are exact, but
# a couple of old bank accounts are missing pre-2020 opening balances, so the
# absolute cash balance is anchored to one known-correct figure (QuickBooks' cash
# at a date) and rolled forward with exact movement. Defaults to PDS's cash at
# 2026-01-01; only set these if the books are restated.
# PDS_BOOKS_CASH_ANCHOR_DATE=2026-01-01
# PDS_BOOKS_CASH_ANCHOR_AMOUNT=92885.90

# ---------------------------------------------------------------------------
# Legacy direct QuickBooks OAuth (optional). No longer used by the app UI or the
# assistant — the /api/quickbooks/* connect routes remain but the books flow
# through I AM CFO above. Leave unset unless you deliberately use the old path.
# ---------------------------------------------------------------------------
# QBO_CLIENT_ID=YOUR-INTUIT-CLIENT-ID
# QBO_CLIENT_SECRET=YOUR-INTUIT-CLIENT-SECRET
# QBO_ENVIRONMENT=production
# QBO_REDIRECT_URI=https://YOUR-DOMAIN/api/quickbooks/callback

# ---------------------------------------------------------------------------
# Zordon team worker (worker/) — a SEPARATE Railway service, NOT the web app.
# Only set these on that service (see worker/README.md). It drives the
# background specialist crew off the team_runs queue.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co   # or reuse NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY # required (bypasses RLS)
# ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY        # required (the crew is Claude)
# POLL_INTERVAL_MS=5000                            # optional (always-on mode)
# RUN_ONCE=true                                    # optional (cron mode)

# Optional: force-redirect the app to one canonical hostname (inert unless set).
# CANONICAL_HOST=app.pdslogix.com

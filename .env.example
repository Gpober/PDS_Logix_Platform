# Supabase — public keys (safe to expose to the browser; anon key only).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only — never NEXT_PUBLIC_, never shipped to the client.
# Optional: used by narrow server tasks that need to bypass RLS.
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Server-only. Enables the "Logix" AI assistant (owner/admin only). The
# Assistant tab shows a setup notice until this is set.
# Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY

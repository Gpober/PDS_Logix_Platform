# Supabase — public keys (safe to expose to the browser; anon key only).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only — never NEXT_PUBLIC_, never shipped to the client.
# Optional for the web app (narrow server tasks that bypass RLS). REQUIRED for
# the Zordon team worker (worker/), which runs with no user session — see below.
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Server-only. Enables the "Zordon" AI assistant (owner/admin only). The
# Assistant tab shows a setup notice until this is set.
# Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY

# ---------------------------------------------------------------------------
# QuickBooks Online (server-only). Powers "Send to QuickBooks" on jobs, the
# QuickBooks card in Settings, and Zordon's invoice/bill tools. Create an app at
# developer.intuit.com, add the Accounting scope, and register the redirect URI:
#   https://YOUR-DOMAIN/api/quickbooks/callback
# Until these are set, the QuickBooks features show a "not configured" notice.
# ---------------------------------------------------------------------------
# QBO_CLIENT_ID=YOUR-INTUIT-CLIENT-ID
# QBO_CLIENT_SECRET=YOUR-INTUIT-CLIENT-SECRET
# 'production' (real books) or 'sandbox' (test company). Defaults to production.
# QBO_ENVIRONMENT=production
# Optional: override the OAuth redirect URI (defaults to <origin>/api/quickbooks/callback).
# QBO_REDIRECT_URI=https://YOUR-DOMAIN/api/quickbooks/callback

# ---------------------------------------------------------------------------
# Zordon team worker (worker/) — a SEPARATE Railway service, NOT the web app.
# Only set these on that service (see worker/README.md). It drives the
# background specialist crew off the team_runs queue.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co   # or reuse NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY # required (bypasses RLS)
# ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY        # required (the crew is Claude)
# POLL_INTERVAL_MS=5000                            # optional (always-on mode)
# RUN_ONCE=true                                    # optional (cron mode)

# Optional: force-redirect the app to one canonical hostname (inert unless set).
# CANONICAL_HOST=app.pdslogix.com

# Postgres connection string for the PDS ledger database (the "PDS Lgix"
# Supabase project). Use the TRANSACTION POOLER string (port 6543) so
# serverless invocations don't exhaust direct connections:
#   Supabase → Project Settings → Database → Connection string → Transaction
PDS_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-2.pooler.supabase.com:6543/postgres
